#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v gradle >/dev/null 2>&1; then
  echo "Gradle is required to build the Android template. Install it with: sudo apt-get update && sudo apt-get install -y gradle" >&2
  exit 1
fi

cd "$SCRIPT_DIR"
exec gradle "$@"
